{
  "name": "ordr-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "원랜디 로컬 조합 도우미",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/core.test.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "kr.ordr.helper",
    "productName": "ORDR 조합도우미",
    "files": ["electron/**/*", "app/**/*", "data/units.seed.json", "package.json"],
    "win": { "target": "portable" }
  }
}
